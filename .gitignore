# === SentinelMesh .gitignore ===

# KB master and phases are shared deliverables — must be tracked
# (phases/ was originally gitignored as local-only planning docs; now promoted to shared repo deliverable)
!phases/
!kb_master/

# Python
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/
*.egg
.venv/
venv/
env/

# Docker
docker-compose.override.yml

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini

# Environment variables
.env
.env.local
.env.*.local

# Logs
*.log

# Node (for future frontend)
node_modules/
SysArch.jpg
SysArch (1).jpg
SysArch.drawio
SysArch (1).drawio
SysArch.drawio.crswap