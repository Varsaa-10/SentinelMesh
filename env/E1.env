# Environment E1 (reference profile — Kali VM / Docker)
ENV_ID=E1
COMPOSE_PROJECT_NAME=sentinelmesh
CONTAINER_PREFIX=sentinelmesh
LAB_NET_NAME=sentinelmesh_net

# Container names
WEBAPP_CONTAINER=sentinelmesh-webapp
AUTHSERVICE_CONTAINER=sentinelmesh-authservice
DATABASE_CONTAINER=sentinelmesh-database
LOGCOLLECTOR_CONTAINER=sentinelmesh-logcollector
DASHBOARD_CONTAINER=sentinelmesh-dashboard
PROXY_CONTAINER=sentinelmesh-proxy
NGROK_CONTAINER=sentinelmesh-ngrok
DEBUG_CONTAINER=sentinelmesh-debug

# Host-bound ports
WEBAPP_PORT=5000
AUTHSERVICE_PORT=5001
POSTGRES_PORT=5432
GRAFANA_PORT=3000
FLUENTD_PORT=24224

# Shared log directory inside containers
LOG_DIR=/var/log/sentinelmesh

# Database & application credentials
DB_NAME=sentinelmesh
DB_USER=postgres
DB_PASS=postgres
JWT_SECRET=sentinelmesh-secret-key
TEST_USER=testuser
TEST_PASS=testpass

# Kept credentials (intentionally left at defaults because scenarios exploit them):
# - AUTH_DEFAULT_USER=admin / AUTH_DEFAULT_PASS=admin123 : required by S3 (scenario3_default_credentials.sh) and S10 stage 2
# - GRAFANA_ADMIN_USER=admin / GRAFANA_ADMIN_PASS=admin   : required by S7 (scenario7_grafana_default_creds.sh)
AUTH_DEFAULT_USER=admin
AUTH_DEFAULT_PASS=admin123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin
