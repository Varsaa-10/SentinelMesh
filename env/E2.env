# Environment E2 (Ubuntu 24.04 VM / Docker — rotated non-attacked credentials, ports, names, and log path)
ENV_ID=E2
COMPOSE_PROJECT_NAME=smx
CONTAINER_PREFIX=smx
LAB_NET_NAME=smx_net

# Container names
WEBAPP_CONTAINER=smx-webapp
AUTHSERVICE_CONTAINER=smx-authservice
DATABASE_CONTAINER=smx-database
LOGCOLLECTOR_CONTAINER=smx-logcollector
DASHBOARD_CONTAINER=smx-dashboard
PROXY_CONTAINER=smx-proxy
NGROK_CONTAINER=smx-ngrok
DEBUG_CONTAINER=smx-debug

# Host-bound ports
WEBAPP_PORT=6000
AUTHSERVICE_PORT=6001
POSTGRES_PORT=6432
GRAFANA_PORT=3300
FLUENTD_PORT=25224

# Shared log directory inside containers
LOG_DIR=/srv/smx/logs

# Database & application credentials (changed for E2; not attacked by any scenario)
DB_NAME=smx
DB_USER=postgres
DB_PASS=smx_pg_9d4e8a2f7c1b6305
JWT_SECRET=smx_jwt_4b8e2f91c7d360a5e8b1d4f2
TEST_USER=testuser
TEST_PASS=smx_user_7c3a9e15b8d240f6

# Kept credentials (intentionally kept at defaults because scenarios exploit them):
# - AUTH_DEFAULT_USER=admin / AUTH_DEFAULT_PASS=admin123 : required by S3 (scenario3_default_credentials.sh) and S10 stage 2
# - GRAFANA_ADMIN_USER=admin / GRAFANA_ADMIN_PASS=admin   : required by S7 (scenario7_grafana_default_creds.sh)
AUTH_DEFAULT_USER=admin
AUTH_DEFAULT_PASS=admin123
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASS=admin
