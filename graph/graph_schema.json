{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SentinelMesh Attack Graph",
    "description": "Schema for the attack-graph output produced by Module C1.",
    "type": "object",
    "required": [
        "graph_id",
        "nodes",
        "edges",
        "paths"
    ],
    "properties": {
        "graph_id": {
            "type": "string",
            "description": "Unique identifier for this graph (run_id + timestamp)."
        },
        "nodes": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "id",
                    "type",
                    "label",
                    "properties"
                ],
                "properties": {
                    "id": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "container",
                            "process",
                            "network_connection",
                            "technique",
                            "cve"
                        ]
                    },
                    "label": {
                        "type": "string"
                    },
                    "properties": {
                        "type": "object"
                    }
                }
            }
        },
        "edges": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "source",
                    "target",
                    "type",
                    "weight"
                ],
                "properties": {
                    "source": {
                        "type": "string"
                    },
                    "target": {
                        "type": "string"
                    },
                    "type": {
                        "type": "string",
                        "enum": [
                            "technique_adjacency",
                            "cve_dependency",
                            "process_lineage",
                            "network_flow"
                        ]
                    },
                    "weight": {
                        "type": "number",
                        "minimum": 0.0,
                        "maximum": 1.0
                    },
                    "timestamp": {
                        "type": [
                            "string",
                            "null"
                        ]
                    }
                }
            }
        },
        "paths": {
            "type": "array",
            "items": {
                "type": "object",
                "required": [
                    "scenario_id",
                    "ordered_stages",
                    "technique_sequence"
                ],
                "properties": {
                    "scenario_id": {
                        "type": "string"
                    },
                    "ordered_stages": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    },
                    "technique_sequence": {
                        "type": "array",
                        "items": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    }
}